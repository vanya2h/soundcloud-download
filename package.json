{
  "name": "soundcloud-dl",
  "private": true,
  "scripts": {
    "dev":    "pnpm --filter @soundcloud-dl/extension dev",
    "build":  "pnpm --filter @soundcloud-dl/extension build",
    "icons":  "pnpm --filter @soundcloud-dl/scripts run generate",
    "prepare": "pnpm run icons"
  },
  "engines": {
    "pnpm": ">=9",
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.4.1"
    },
    "onlyBuiltDependencies": ["esbuild", "spawn-sync"]
  }
}
